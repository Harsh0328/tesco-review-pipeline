# SMTP Email Configuration for Automated Report Delivery
# IT MUST RENAME THIS FILE TO ".env" AND FILL IN THE CREDENTIALS

# Pipeline Configuration
DEFAULT_REPORT_DAYS=7

# Email Settings
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587

SENDER_EMAIL=bot@cranswick.example.com
SENDER_PASSWORD=your_secure_app_password

# Comma-separated list of people who should receive the weekly report
RECIPIENT_EMAILS=qa.manager@cranswick.example.com,logistics@cranswick.example.com
